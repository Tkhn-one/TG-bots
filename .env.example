# Get this token from @BotFather. Never commit the real value.
BOT_TOKEN=123456789:replace_me
# SQLite database file; Docker uses /app/data/avito_watcher.sqlite3
DATABASE_PATH=data/avito_watcher.sqlite3
# Lower limit to reduce load and avoid excessive polling.
MIN_CHECK_INTERVAL_MINUTES=5
# Optional: show DEBUG logs.
LOG_LEVEL=INFO
# Optional HTTP/HTTPS proxy for the Telegram Bot API, for example:
# TELEGRAM_PROXY=http://user:password@proxy.example:8080
# Leave empty when api.telegram.org is directly accessible.
TELEGRAM_PROXY=
# Storage guardrails for the list of already-notified listing IDs.
MAX_SEEN_LISTINGS_PER_WATCH=5000
SEEN_LISTING_RETENTION_DAYS=90
